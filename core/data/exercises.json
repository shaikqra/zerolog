{
  "_note": "The exercise database. Order matters: within a movement pattern, earlier exercises are preferred when a gym has the equipment for several. 'detectable' = we expect the watch to recognise it from wrist motion (to be proven with real data).",
  "equipment_types": [
    {"id": "barbell",      "name": "Barbell"},
    {"id": "rack",         "name": "Squat rack"},
    {"id": "bench",        "name": "Flat bench"},
    {"id": "dumbbells",    "name": "Dumbbells"},
    {"id": "cable",        "name": "Cable machine"},
    {"id": "lat_pulldown", "name": "Lat pulldown machine"},
    {"id": "leg_press",    "name": "Leg press machine"}
  ],
  "exercises": [
    {"id": "bench_press",           "name": "Barbell bench press",       "pattern": "horizontal_push",    "kind": "compound",  "equipment": ["barbell", "bench", "rack"], "rep_range": [6, 10],  "increment_kg": 2.5, "sets": 3, "detectable": true},
    {"id": "db_bench_press",        "name": "Dumbbell bench press",      "pattern": "horizontal_push",    "kind": "compound",  "equipment": ["dumbbells", "bench"],       "rep_range": [8, 12],  "increment_kg": 2.0, "sets": 3, "detectable": true},

    {"id": "overhead_press",        "name": "Barbell overhead press",    "pattern": "vertical_push",      "kind": "compound",  "equipment": ["barbell", "rack"],          "rep_range": [6, 10],  "increment_kg": 2.5, "sets": 3, "detectable": true},
    {"id": "db_shoulder_press",     "name": "Dumbbell shoulder press",   "pattern": "vertical_push",      "kind": "compound",  "equipment": ["dumbbells", "bench"],       "rep_range": [8, 12],  "increment_kg": 2.0, "sets": 3, "detectable": true},

    {"id": "lateral_raise",         "name": "Dumbbell lateral raise",    "pattern": "shoulder_abduction", "kind": "isolation", "equipment": ["dumbbells"],                "rep_range": [12, 15], "increment_kg": 2.0, "sets": 3, "detectable": true},
    {"id": "cable_lateral_raise",   "name": "Cable lateral raise",       "pattern": "shoulder_abduction", "kind": "isolation", "equipment": ["cable"],                    "rep_range": [12, 15], "increment_kg": 2.5, "sets": 3, "detectable": true},

    {"id": "tricep_pushdown",       "name": "Cable tricep pushdown",     "pattern": "elbow_extension",    "kind": "isolation", "equipment": ["cable"],                    "rep_range": [10, 15], "increment_kg": 2.5, "sets": 3, "detectable": true},
    {"id": "db_overhead_extension", "name": "Dumbbell overhead extension","pattern": "elbow_extension",   "kind": "isolation", "equipment": ["dumbbells"],                "rep_range": [10, 15], "increment_kg": 2.0, "sets": 3, "detectable": true},

    {"id": "lat_pulldown",          "name": "Lat pulldown",              "pattern": "vertical_pull",      "kind": "compound",  "equipment": ["lat_pulldown"],             "rep_range": [8, 12],  "increment_kg": 2.5, "sets": 3, "detectable": true},

    {"id": "barbell_row",           "name": "Barbell row",               "pattern": "horizontal_pull",    "kind": "compound",  "equipment": ["barbell"],                  "rep_range": [6, 10],  "increment_kg": 2.5, "sets": 3, "detectable": true},
    {"id": "db_row",                "name": "One-arm dumbbell row",      "pattern": "horizontal_pull",    "kind": "compound",  "equipment": ["dumbbells", "bench"],       "rep_range": [8, 12],  "increment_kg": 2.0, "sets": 3, "detectable": true},
    {"id": "seated_cable_row",      "name": "Seated cable row",          "pattern": "horizontal_pull",    "kind": "compound",  "equipment": ["cable"],                    "rep_range": [8, 12],  "increment_kg": 2.5, "sets": 3, "detectable": true},

    {"id": "db_curl",               "name": "Dumbbell curl",             "pattern": "elbow_flexion",      "kind": "isolation", "equipment": ["dumbbells"],                "rep_range": [8, 12],  "increment_kg": 2.0, "sets": 3, "detectable": true},
    {"id": "cable_curl",            "name": "Cable curl",                "pattern": "elbow_flexion",      "kind": "isolation", "equipment": ["cable"],                    "rep_range": [10, 15], "increment_kg": 2.5, "sets": 3, "detectable": true},

    {"id": "romanian_deadlift",     "name": "Romanian deadlift",         "pattern": "hinge",              "kind": "compound",  "equipment": ["barbell"],                  "rep_range": [6, 10],  "increment_kg": 2.5, "sets": 3, "detectable": true},
    {"id": "db_romanian_deadlift",  "name": "Dumbbell Romanian deadlift","pattern": "hinge",              "kind": "compound",  "equipment": ["dumbbells"],                "rep_range": [8, 12],  "increment_kg": 2.0, "sets": 3, "detectable": true},

    {"id": "back_squat",            "name": "Barbell back squat",        "pattern": "knee_dominant",      "kind": "compound",  "equipment": ["barbell", "rack"],          "rep_range": [5, 8],   "increment_kg": 2.5, "sets": 3, "detectable": false},
    {"id": "leg_press",             "name": "Leg press",                 "pattern": "knee_dominant",      "kind": "compound",  "equipment": ["leg_press"],                "rep_range": [8, 12],  "increment_kg": 5.0, "sets": 3, "detectable": false},
    {"id": "goblet_squat",          "name": "Goblet squat",              "pattern": "knee_dominant",      "kind": "compound",  "equipment": ["dumbbells"],                "rep_range": [8, 12],  "increment_kg": 2.0, "sets": 3, "detectable": false}
  ],
  "sessions": {
    "order": ["push", "pull", "legs"],
    "push": ["horizontal_push", "vertical_push", "shoulder_abduction", "elbow_extension"],
    "pull": ["vertical_pull", "horizontal_pull", "elbow_flexion"],
    "legs": ["knee_dominant", "hinge", "knee_dominant"]
  }
